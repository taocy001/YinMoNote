.DS_Store

# Go compiled binary
backend/yinmo-backend

# E2E test artifacts (generated by Playwright)
tests/e2e/playwright-report/
tests/e2e/test-results/

# Native build outputs
dist/

# frontend dist copied into backend for go:embed (generated by build scripts)
backend/dist/*
!backend/dist/.gitkeep
# Local tool configuration
.claude/
.gemini/

# Internal architecture/audit documents (never publish)
docs/arch/
CLAUDE.md
ARCHITECTURE.md
DEPLOYMENT.md
CHANGELOG.md

# Audit artifacts (may contain security-sensitive information)
buglist.md

# Runtime secrets
config.json
.env
*.pem
*.key
