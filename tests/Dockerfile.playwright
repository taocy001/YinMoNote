# Playwright test runner image – Chromium on Alpine
#
# Uses Alpine's system Chromium (via apk) instead of the bundled Playwright
# browser to avoid a ~300 MB download on every image rebuild.
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 tells Playwright not to download its own
# Chromium; PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH points it at the system one.
# syntax=docker/dockerfile:1
FROM node:20-alpine

# ── System Chromium + required libs + CJK fonts ─────────────────────────────
RUN apk add --no-cache \
        chromium \
        nss \
        freetype \
        harfbuzz \
        ca-certificates \
        ttf-freefont \
        font-noto \
        font-noto-cjk \
        udev \
        ffmpeg

WORKDIR /tests

# ── npm packages ─────────────────────────────────────────────────────────────
COPY tests/e2e/package.json ./
# --mount=type=cache persists the npm cache across rebuilds
RUN --mount=type=cache,target=/root/.npm \
    npm install --include=dev

COPY tests/e2e/ .

# ── Use Alpine's system Chromium instead of bundled browser ─────────────────
# Alpine installs the binary at /usr/bin/chromium-browser
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

CMD ["npx", "playwright", "test", "--reporter=list,html"]
