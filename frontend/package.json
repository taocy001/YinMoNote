{
  "name": "yinmo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts,.vue",
    "lint:fix": "eslint src tests --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "deploy": "docker compose up -d --build && docker image prune -f"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.20.2",
    "@tiptap/extension-color": "^3.22.1",
    "@tiptap/extension-gapcursor": "^3.20.2",
    "@tiptap/extension-highlight": "^3.20.2",
    "@tiptap/extension-image": "^3.20.2",
    "@tiptap/extension-link": "^3.20.2",
    "@tiptap/extension-subscript": "^3.20.2",
    "@tiptap/extension-superscript": "^3.20.2",
    "@tiptap/extension-table": "^3.20.2",
    "@tiptap/extension-table-cell": "^3.20.2",
    "@tiptap/extension-table-header": "^3.20.2",
    "@tiptap/extension-table-row": "^3.20.2",
    "@tiptap/extension-task-item": "^3.20.2",
    "@tiptap/extension-task-list": "^3.20.2",
    "@tiptap/extension-text-align": "^3.22.1",
    "@tiptap/extension-text-style": "^3.22.1",
    "@tiptap/extension-typography": "^3.20.2",
    "@tiptap/extension-underline": "^3.20.2",
    "@tiptap/starter-kit": "^3.20.2",
    "@tiptap/vue-3": "^3.20.2",
    "axios": "^1.13.6",
    "common-tags": "^1.8.2",
    "diff-match-patch": "^1.0.5",
    "fflate": "^0.8.2",
    "jsdom": "^29.0.1",
    "katex": "^0.16.11",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "mermaid": "^11.4.1",
    "prosemirror-state": "^1.4.4",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^14.12.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.8"
  }
}
